                                <mass value="0.3738306581420113" />
                                <inertia ixx="0.0007705630795353672" iyy="0.0005242439068715325" izz="0.0002956222039192135" ixy="1.47298558348824e-06" iyz="-2.5974240771499857e-05" ixz="2.161764697209049e-07" />
