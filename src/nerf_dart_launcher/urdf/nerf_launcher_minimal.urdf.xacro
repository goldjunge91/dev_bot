<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="nerf_launcher" params="parent *origin">

        <!-- Montageplatte (Mounting Plate) - Fixed to Parent -->
        <joint name="nerf_launcher_mount_joint" type="fixed">
            <xacro:insert_block name="origin" />
            <parent link="${parent}" />
            <child link="Montageplatte" />
        </joint>

        <link name="Montageplatte">
            <visual>
                <geometry>
                    <box size="0.1 0.1 0.01"/>
                </geometry>
                <material name="grey">
                    <color rgba="0.5 0.5 0.5 1.0"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <box size="0.1 0.1 0.01"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.1"/>
                <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
            </inertial>
        </link>

        <!-- Motor Plate - Fixed to Montageplatte -->
        <joint name="Motor_und_Magazinplatte_Starr-1" type="fixed">
            <origin xyz="0 0 0.02" rpy="0 0 0" />
            <parent link="Montageplatte" />
            <child link="Motor_und_Magazinplatte" />
        </joint>

        <link name="Motor_und_Magazinplatte">
             <visual>
                <geometry>
                    <box size="0.05 0.05 0.01"/>
                </geometry>
                 <material name="black">
                    <color rgba="0 0 0 1.0"/>
                </material>
            </visual>
             <collision>
                <geometry>
                    <box size="0.05 0.05 0.01"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.1"/>
                <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
            </inertial>
        </link>

         <!-- Dart Pusher - Moving Joint -->
        <joint name="dart_pusher_joint" type="continuous">
            <origin xyz="0 0.05 0" rpy="0 0 0" />
            <parent link="Motor_und_Magazinplatte" />
            <child link="Dart_Pusher" />
            <axis xyz="0 0 1" />
        </joint>

        <link name="Dart_Pusher">
             <visual>
                <geometry>
                    <box size="0.02 0.02 0.05"/>
                </geometry>
                 <material name="red">
                    <color rgba="1 0 0 1.0"/>
                </material>
            </visual>
             <collision>
                <geometry>
                    <box size="0.02 0.02 0.05"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.05"/>
                <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
            </inertial>
        </link>
        
        <!-- Dummy Links for Flywheels to satisfy ros2_control -->
        <joint name="flywheel_left_joint" type="continuous">
            <origin xyz="-0.05 0 0" rpy="0 0 0" />
            <parent link="Motor_und_Magazinplatte" />
            <child link="flywheel_left_link" />
            <axis xyz="0 1 0"/>
        </joint>
        <link name="flywheel_left_link">
             <inertial>
                <mass value="0.05"/>
                <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
            </inertial>
        </link>

         <joint name="flywheel_right_joint" type="continuous">
            <origin xyz="0.05 0 0" rpy="0 0 0" />
            <parent link="Motor_und_Magazinplatte" />
            <child link="flywheel_right_link" />
             <axis xyz="0 1 0"/>
        </joint>
        <link name="flywheel_right_link">
             <inertial>
                <mass value="0.05"/>
                <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
            </inertial>
        </link>
        
         <joint name="trigger_joint" type="revolute">
            <origin xyz="0 -0.05 0" rpy="0 0 0" />
            <parent link="Motor_und_Magazinplatte" />
            <child link="trigger_link" />
            <axis xyz="1 0 0"/>
            <limit lower="0" upper="1" effort="10" velocity="10"/>
        </joint>
        <link name="trigger_link">
             <inertial>
                <mass value="0.05"/>
                <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
            </inertial>
        </link>

    </xacro:macro>

</robot>
