<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gubot_controller</name>
  <version>0.1.0</version>
  <description>ros2_control-Bringup des Gubot One: controller_manager, Controller-Konfiguration und twist_mux (Schema: rosbot_controller)</description>
  <maintainer email="m.tozzi91@icloud.com">goldjunge91</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>gubot_description</exec_depend>
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>imu_sensor_broadcaster</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>mecanum_drive_controller</exec_depend>
  <exec_depend>nerf_launch_system</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>twist_mux</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
