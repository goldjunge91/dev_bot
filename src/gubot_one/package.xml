<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gubot_one</name>
  <version>0.1.0</version>
  <description>Metapaket des Gubot One — zieht alle gubot_*-Pakete (Schema: rosbot-Metapaket aus rosbot_ros)</description>
  <maintainer email="m.tozzi91@icloud.com">goldjunge91</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>gubot_description</exec_depend>
  <exec_depend>gubot_controller</exec_depend>
  <exec_depend>gubot_gazebo</exec_depend>
  <exec_depend>gubot_localization</exec_depend>
  <exec_depend>gubot_bringup</exec_depend>
  <exec_depend>gubot_utils</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
