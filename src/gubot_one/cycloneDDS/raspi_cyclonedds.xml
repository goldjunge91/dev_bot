<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces>
        <!-- Allow any interface, prioritizing wlan0/eth0 over internal ones -->
        <NetworkInterface name="wlan0" priority="default" multicast="default" />
        <NetworkInterface name="eth0" priority="default" multicast="default" />
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
      <Transport>udp</Transport>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
      <Peers>
        <!-- Uncomment and add your PC IP here if needed for cross-device talk -->
        <!-- <Peer Address="192.168.178.XX"/> -->
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>