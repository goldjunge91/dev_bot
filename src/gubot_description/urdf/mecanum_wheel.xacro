<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Mecanum-Rad (Joint + Link, ohne Gazebo-Tags — Sim-Reibung liegt in
         gazebo_sim.xacro). Parameter:
           prefix    fl/fr/rl/rr
           x_reflect +1 vorne, -1 hinten
           y_reflect +1 links, -1 rechts
           mesh      mecanum_a (rechts) / mecanum_b (links) -->
    <xacro:macro name="mecanum_wheel" params="prefix x_reflect y_reflect mesh">
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="body_link"/>
            <child link="${prefix}_wheel_link"/>
            <origin xyz="${x_reflect * wheel_offset_x} ${y_reflect * wheel_offset_y} 0.0" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 1.0 0.0"/>
            <limit effort="${wheel_effort_limit}" velocity="${wheel_velocity_limit}"/>
            <dynamics damping="${wheel_damping}" friction="${wheel_friction}"/>
        </joint>
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <mesh filename="file://$(find gubot_description)/meshes/wheels/${mesh}.dae"/>
                </geometry>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
                </geometry>
                <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 0.0"/>
            </collision>
            <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}" radius="${wheel_radius}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>
    </xacro:macro>
</robot>
