<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Referenz: rosbot_ws/src/rosbot_ros/rosbot_description/urdf/common/ros2_control.urdf.xacro
         und common/gazebo.urdf.xacro.
         Anpassungen:
         - Gelenkbezeichnungen: fl/fr/rl/rr_wheel_joint (Referenz-Schema)
         - controller_config als xacro-Argument (Pfad wird von load_urdf.launch.py injiziert)
         - transition_event-Remappings hinzugefügt (wie Referenz)
         - position_proportional_gain entfernt (wird von GazeboSimSystem nicht unterstützt)
         - Sensor-Name "imu_sensor" konsistent mit controllers.yaml sensor_name und
           dem Gazebo-Sensor in gazebo_sim.xacro
    -->

    <!-- NEW: controller config path injected by load_urdf.launch.py at runtime -->
    <xacro:arg name="controller_config"
        default="$(find gubot_controller)/config/controllers.yaml"/>

    <xacro:include filename="ros2_control_common.xacro"/>

    <ros2_control name="GubotIgnitionSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <!-- Gelenkbezeichnungen: fl/fr/rl/rr_wheel_joint (Referenz rosbot_xl-Schema) -->
        <xacro:ros2_control_wheel_joint name="fl_wheel_joint" sim="true"/>
        <xacro:ros2_control_wheel_joint name="fr_wheel_joint" sim="true"/>
        <xacro:ros2_control_wheel_joint name="rl_wheel_joint" sim="true"/>
        <xacro:ros2_control_wheel_joint name="rr_wheel_joint" sim="true"/>

        <!-- Nerf-Joints: NUR wenn use_nerf_hardware=true, sonst existieren diese Joints nicht in der URDF -->
        <xacro:if value="$(arg use_nerf_hardware)">
            <joint name="trigger_joint">
                <command_interface name="position">
                    <param name="p">50.0</param>
                    <param name="d">1.0</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">0.0</param>
                </state_interface>
            </joint>
            <joint name="dart_pusher_joint">
                <command_interface name="velocity"/>
                <state_interface name="velocity"/>
                <state_interface name="position"/>
            </joint>
            <joint name="system_arming_joint">
                <command_interface name="position"/>
                <state_interface name="position"/>
            </joint>
        </xacro:if>

        <xacro:ros2_control_imu_sensor/>
    </ros2_control>

    <gazebo>
        <!-- Referenz: common/gazebo.urdf.xacro macro "controller" -->
        <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
            <controller_manager_name>controller_manager</controller_manager_name>
            <parameters>$(arg controller_config)</parameters>
            <ros>
                <!-- Mecanum-Drive Remappings (wie Referenz common/gazebo.urdf.xacro) -->
                <remapping>mecanum_drive_controller/cmd_vel_unstamped:=cmd_vel</remapping>
                <remapping>mecanum_drive_controller/odom:=odometry/wheels</remapping>
                <!-- NEU: transition_event Remappings (fehlten bisher, Referenz-Pattern) -->
                <remapping>mecanum_drive_controller/transition_event:=_mecanum_drive_controller/transition_event</remapping>
                <remapping>differential_drive_controller/cmd_vel_unstamped:=cmd_vel</remapping>
                <remapping>differential_drive_controller/odom:=odometry/wheels</remapping>
                <remapping>differential_drive_controller/transition_event:=_differential_drive_controller/transition_event</remapping>
                <remapping>imu_broadcaster/imu:=imu/data</remapping>
                <remapping>imu_broadcaster/transition_event:=_imu_broadcaster/transition_event</remapping>
                <remapping>joint_state_broadcaster/transition_event:=_joint_state_broadcaster/transition_event</remapping>
                <remapping>/diagnostics:=diagnostics</remapping>
                <remapping>/tf:=tf</remapping>
                <remapping>/tf_static:=tf_static</remapping>
            </ros>
        </plugin>
    </gazebo>
</robot>
