<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:arg name="use_nerf_hardware" default="true"/>
    <xacro:arg name="nerf_port" default="/dev/serial/by-id/usb-Arduino_LLC_Arduino_Leonardo-if00"/>
    <xacro:include filename="$(find nerf_launch_system)/description/urdf/ros2_control_hardware_nerf.xacro" />
    <ros2_control name="RealRobot" type="system">
        <hardware>
            <plugin>mecanum_pico/MecanumPicoHardware</plugin>
            <!-- <param name="front_left_wheel_name">front_left_wheel_joint</param> -->
            <!-- <param name="front_right_wheel_name">front_right_wheel_joint</param> -->
            <!-- <param name="rear_left_wheel_name">rear_left_wheel_joint</param> -->
            <!-- <param name="rear_right_wheel_name">rear_right_wheel_joint</param> -->
            <param name="front_left_wheel_name">fl_wheel_joint</param>
            <param name="front_right_wheel_name">fr_wheel_joint</param>
            <param name="rear_left_wheel_name">rl_wheel_joint</param>
            <param name="rear_right_wheel_name">rr_wheel_joint</param>
            <param name="loop_rate">30</param>
            <param name="device">/dev/serial/by-id/usb-Raspberry_Pi_Pico_50443405786ACA1C-if00</param>
            <param name="baud_rate">115200</param>
            <param name="timeout_ms">1000</param>
            <param name="enc_counts_per_rev">3436</param>
        </hardware>
        <joint name="fl_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="fr_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="rl_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="rr_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <sensor name="imu_sensor">
            <state_interface name="linear_acceleration.x"/>
            <state_interface name="linear_acceleration.y"/>
            <state_interface name="linear_acceleration.z"/>
            <state_interface name="angular_velocity.x"/>
            <state_interface name="angular_velocity.y"/>
            <state_interface name="angular_velocity.z"/>
            <state_interface name="orientation.x"/>
            <state_interface name="orientation.y"/>
            <state_interface name="orientation.z"/>
            <state_interface name="orientation.w"/>
        </sensor>
    </ros2_control>
    <xacro:if value="$(arg use_nerf_hardware)">
        <!-- Einzige Quelle der Wahrheit für den NerfSystem-Block: Macro aus
             nerf_launch_system statt lokal dupliziert (vermeidet Drift). -->
        <xacro:nerf_ros2_control_hardware port="$(arg nerf_port)" tilt_min="-0.52" tilt_max="0.52"/>
    </xacro:if>
</robot>