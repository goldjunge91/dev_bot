<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Reine Geometrie (Links/Joints/Inertials) — keine Gazebo-Tags.
         Eigenschaften/Materialien: properties.xacro (via gubot_one_main).
         Sim-spezifisches (IMU-Sensor, Rad-Reibung, Gazebo-Materialien):
         gazebo_sim.xacro. -->
    <xacro:include filename="inertial_macros.xacro"/>
    <xacro:include filename="mecanum_wheel.xacro"/>

    <!-- BASE LINK -->
    <link name="base_link">

    </link>
    <!-- BODY_LINK (wie Referenz rosbot_xl: base_link -> body_link mit Z=wheel_radius Offset) -->
    <joint name="base_to_body_joint" type="fixed">
        <parent link="base_link"/>
        <child link="body_link"/>
        <origin xyz="0.0 0.0 ${wheel_radius}" rpy="0.0 0.0 0.0"/>
    </joint>
    <link name="body_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="file://$(find gubot_description)/meshes/bases/waffle_pi_base.stl"
                      scale="${chassis_mesh_scale_x} ${chassis_mesh_scale_y} ${chassis_mesh_scale_z}"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 ${chassis_height/2}"/>
            <geometry>
                <box size="${chassis_length - 0.01} ${chassis_width - 0.01} ${chassis_height - 0.01}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
            <origin xyz="0.0 0.0 ${chassis_height/2}" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>
    <!-- IMU LINK -->
    <joint name="imu_joint" type="fixed">
        <parent link="body_link"/>
        <child link="imu_link"/>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </joint>
    <link name="imu_link">
        <visual>
            <geometry>
                <box size="0.02 0.02 0.02"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.02 0.02 0.02"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.01" x="0.02" y="0.02" z="0.02">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>
    <!-- WHEELS (wie Referenz: fl/fr/rl/rr_wheel_joint, parent=body_link, axis=Y, RPY=0) -->
    <xacro:mecanum_wheel prefix="fl" x_reflect="1"  y_reflect="1"  mesh="mecanum_b"/>
    <xacro:mecanum_wheel prefix="fr" x_reflect="1"  y_reflect="-1" mesh="mecanum_a"/>
    <xacro:mecanum_wheel prefix="rl" x_reflect="-1" y_reflect="1"  mesh="mecanum_b"/>
    <xacro:mecanum_wheel prefix="rr" x_reflect="-1" y_reflect="-1" mesh="mecanum_a"/>
</robot>
