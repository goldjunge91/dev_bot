<?xml version="1.0"?>
<!-- MIGRATION STATUS: COMPLETE (Sprint 3)                                     -->
<!-- mecanum_robot_description.urdf.xacro — 4-wheel mecanum robot kinematics.  -->
<!-- Ported from diffbot_description.urdf.xacro: 2 wheels + 2 casters          -->
<!--   → 4 mecanum wheels at chassis corners (no casters needed).               -->
<!-- MEASURE YOUR ROBOT: update all xacro:property values below.                -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="mecanum_robot" params="prefix">

    <!-- ================================================================== -->
    <!-- Robot dimensions — MEASURE YOUR ROBOT                              -->
    <!-- ================================================================== -->
    <xacro:property name="PI"           value="3.1415926535897931"/>
    <xacro:property name="base_mass"    value="1.0" />   <!-- kg -->
    <xacro:property name="base_width"   value="0.20" />  <!-- m — track width (left↔right) -->
    <xacro:property name="base_length"  value="0.25" />  <!-- m — wheelbase (front↔rear)   -->
    <xacro:property name="base_height"  value="0.06" />  <!-- m — chassis plate thickness  -->
    <xacro:property name="wheel_mass"   value="0.15" />  <!-- kg per wheel -->
    <xacro:property name="wheel_len"    value="0.025" /> <!-- m — wheel width -->
    <xacro:property name="wheel_radius" value="0.050" /> <!-- m — MEASURE YOUR WHEEL -->
    <!-- z offset: distance from base_link origin down to wheel centre -->
    <xacro:property name="z_offset"     value="${-(base_height/2 + wheel_radius)}" />

    <!-- ================================================================== -->
    <!-- Base link                                                            -->
    <!-- ================================================================== -->
    <link name="${prefix}base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${base_mass}"/>
        <inertia
          ixx="${base_mass/12.0*(base_width*base_width  + base_height*base_height)}" ixy="0" ixz="0"
          iyy="${base_mass/12.0*(base_length*base_length + base_height*base_height)}" iyz="0"
          izz="${base_mass/12.0*(base_length*base_length + base_width*base_width)}"/>
      </inertial>
    </link>

    <!-- ================================================================== -->
    <!-- Wheel macro — instantiated 4× below                                 -->
    <!-- ================================================================== -->
    <xacro:macro name="mecanum_wheel" params="prefix name x_pos y_pos">
      <joint name="${prefix}${name}_joint" type="continuous">
        <parent link="${prefix}base_link"/>
        <child  link="${prefix}${name}"/>
        <origin xyz="${x_pos} ${y_pos} ${z_offset}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <dynamics damping="0.2"/>
      </joint>

      <link name="${prefix}${name}">
        <visual>
          <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
          <geometry><cylinder length="${wheel_len}" radius="${wheel_radius}"/></geometry>
          <material name="black"/>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
          <geometry><cylinder length="${wheel_len}" radius="${wheel_radius}"/></geometry>
        </collision>
        <inertial>
          <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
          <mass value="${wheel_mass}"/>
          <inertia
            ixx="${wheel_mass/12.0*(3*wheel_radius*wheel_radius + wheel_len*wheel_len)}" ixy="0" ixz="0"
            iyy="${wheel_mass/2.0*wheel_radius*wheel_radius}"                            iyz="0"
            izz="${wheel_mass/12.0*(3*wheel_radius*wheel_radius + wheel_len*wheel_len)}"/>
        </inertial>
      </link>
    </xacro:macro>

    <!-- ================================================================== -->
    <!-- Instantiate 4 wheels at chassis corners                             -->
    <!-- x_pos: +front / -rear   y_pos: +left / -right                      -->
    <!-- ================================================================== -->
    <xacro:mecanum_wheel prefix="${prefix}" name="front_left_wheel"
      x_pos=" ${base_length/2}" y_pos=" ${base_width/2 + wheel_len/2}"/>

    <xacro:mecanum_wheel prefix="${prefix}" name="front_right_wheel"
      x_pos=" ${base_length/2}" y_pos="-${base_width/2 + wheel_len/2}"/>

    <xacro:mecanum_wheel prefix="${prefix}" name="rear_left_wheel"
      x_pos="-${base_length/2}" y_pos=" ${base_width/2 + wheel_len/2}"/>

    <xacro:mecanum_wheel prefix="${prefix}" name="rear_right_wheel"
      x_pos="-${base_length/2}" y_pos="-${base_width/2 + wheel_len/2}"/>

  </xacro:macro>

</robot>
