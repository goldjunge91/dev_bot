<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gubot_bringup</name>
  <version>0.1.0</version>
  <description>Top-Level-Bringup des echten Gubot One: Gesamtstart, Joystick, Kamera, Lidar (Schema: rosbot_bringup)</description>
  <maintainer email="m.tozzi91@icloud.com">goldjunge91</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>gubot_description</exec_depend>
  <exec_depend>gubot_controller</exec_depend>
  <exec_depend>gubot_localization</exec_depend>
  <exec_depend>gubot_utils</exec_depend>
  <exec_depend>face_tracker</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>v4l2_camera</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
