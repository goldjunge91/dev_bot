<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="nerf_standalone">

    <!-- World Link -->
    <link name="world"/>

    <!-- Joint: Montageplatte -> Motor_und_Magazinplatte (Fixed for now to build base) -->
    <!-- NOTE: In original URDF, Motor_und_Magazinplatte was PARENT of Montageplatte.
         But here we attached Montageplatte to world. 
         Let's stick to the physical reality: Motor_und_Magazinplatte is the big base plate.
         So let's attach Motor_und_Magazinplatte to World, and Montageplatte to IT.
         
         RE-STRUCTURING to match original hierarchy:
         World -> Motor_und_Magazinplatte (Base) -> Montageplatte (Trigger)
    -->

    <joint name="world_to_montage_joint" type="fixed">
        <parent link="world"/>
        <child link="Montageplatte"/>
        <origin xyz="0 0 0.5" rpy="0 -1.5708 0"/>
    </joint>

    <!-- Refined Montageplatte (Visual update to match relative position) -->
    <link name="Montageplatte">
        <visual>
            <origin xyz="0.0012 0.1035 -0.0889" rpy="-3.1416 -1.5708 0"/>
            <geometry>
                <mesh filename="file://$(find nerf_standalone)/description/meshes/Montageplatte.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="orange">
                <color rgba="1.0 0.5 0.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.05 0.1 0.02"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.2"/>
            <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00037"/>
        </inertial>
    </link>

</robot>
