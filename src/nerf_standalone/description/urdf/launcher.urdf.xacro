<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="nerf_standalone">

    <!-- Colors -->
    <material name="white">
        <color rgba="1 1 1 1" />
    </material>

    <material name="orange">
        <color rgba="1 0.3 0.1 1"/>
    </material>

    <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
    </material>

    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>

    <material name="red">
        <color rgba="1 0 0 1"/>
    </material>
    
    <!-- World Link -->
    <link name="world"/>

    <!-- 1. Montageplatte (BASE, connected to world for testing) -->
    <joint name="world_to_montage_joint" type="fixed">
        <parent link="world"/>
        <child link="Montageplatte"/>
        <origin xyz="0 0 0.5" rpy="0 -1.5708 0"/>
    </joint>

    <link name="Montageplatte">
        <visual>
            <origin xyz="0.0012 0.1035 -0.0889" rpy="-3.1416 -1.5708 0"/>
            <geometry>
                <mesh filename="file://$(find nerf_standalone)/description/meshes/Montageplatte.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="orange">
                <color rgba="1.0 0.5 0.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.05 0.1 0.02"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.2"/>
            <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00037"/>
        </inertial>
    </link>

    <!-- 2. Motor_und_Magazinplatte (Attached to Montageplatte) -->
    <joint name="trigger_joint" type="fixed">
        <!-- User specified rotation: X=180, Y=-90. Position: 0.1m forward (Z-axis locally) -->
        <origin xyz="0 0.0975 -0.013768" rpy="3.14159 -1.5708 0"/>
        <parent link="Montageplatte"/>
        <child link="Motor_und_Magazinplatte"/>
    </joint>

    <link name="Motor_und_Magazinplatte">
        <visual>
             <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file://$(find nerf_standalone)/description/meshes/Motor_und_Magazinplatte.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="grey">
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.06 0.08 0.02"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.25"/>
            <inertia ixx="0.00036" ixy="0" ixz="0" iyy="0.00014" iyz="0" izz="0.00048"/>
        </inertial>
    </link>

</robot>
