<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Full ros2_control macro with gazebo plugin - for standalone mode -->
    <xacro:macro name="nerf_ros2_control">

        <gazebo>
            <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
                <robot_param>robot_description</robot_param>
                <robot_param_node>robot_state_publisher</robot_param_node>
                <parameters>$(find nerf_standalone)/config/controllers.yaml</parameters>
                <parameters>$(find nerf_standalone)/config/gains.yaml</parameters>
            </plugin>
        </gazebo>

        <ros2_control name="GazeboSystem" type="system">
            <hardware>
                <plugin>gazebo_ros2_control/GazeboSystem</plugin>
            </hardware>
            
            <joint name="trigger_joint">
                <command_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">6.28</param>
                </state_interface>
            </joint>

            <!-- Pusher Joint (Velocity Control) -->
            <joint name="dart_pusher_joint">
                <command_interface name="velocity"/>
                <state_interface name="velocity"/>
                <state_interface name="position"/>
            </joint>

            <!-- Flywheel Left -->
            <joint name="flywheel_left_joint">
                <command_interface name="velocity"/>
                <state_interface name="velocity"/>
                <state_interface name="position"/>
            </joint>

            <!-- Flywheel Right -->
            <joint name="flywheel_right_joint">
                <command_interface name="velocity"/>
                <state_interface name="velocity"/>
                <state_interface name="position"/>
            </joint>

        </ros2_control>

    </xacro:macro>

    <!-- Joints-only macro for integration mode (no gazebo plugin) -->
    <xacro:macro name="nerf_ros2_control_joints_only">
        
        <joint name="trigger_joint">
            <command_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="position">
              <param name="initial_value">6.28</param>
            </state_interface>
        </joint>

        <!-- Pusher Joint (Velocity Control) -->
        <joint name="dart_pusher_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>

        <!-- Flywheel Left -->
        <joint name="flywheel_left_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>

        <!-- Flywheel Right -->
        <joint name="flywheel_right_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>

    </xacro:macro>

</robot>
