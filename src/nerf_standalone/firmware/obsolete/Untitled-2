#include <Arduino.h>
#include <Servo.h>

namespace Config {
// Pins
const uint8_t PIN_ESC_1 = 2;
const uint8_t PIN_ESC_2 = 3;
const uint8_t PIN_SHOT = 9;
const uint8_t PIN_TILT = 10;

// --- DREHRICHTUNG (Hier invertieren) ---
const bool INV_1 = false; // Auf true setzen, falls Motor 1 falschrum dreht
const bool INV_2 = false; // Auf true setzen, falls Motor 2 falschrum dreht

// ESC Parameter
const uint16_t ESC_MIN = 1000;
const uint16_t ESC_MAX = 2000;
const uint16_t ESC_ARM = 1000;

// Timings
const uint32_t ARM_DELAY_MS = 2000;
const uint32_t SPINUP_MS = 1200;
const uint16_t BRAKE_MS = 15;
const uint32_t AUTO_DISARM_MS = 60000;

// Servo Kalibrierung (Defaults)
const uint16_t SHOT_NEUTRAL_DEFAULT = 1430;
const uint16_t TILT_NEUTRAL_DEFAULT = 1430;
const uint32_t SHOT_DURATION_DEFAULT = 2210;
const uint16_t SHOT_SPEED_OFFSET = 300;
const uint16_t BRAKE_OFFSET = 600;

const uint32_t BAUD_RATE = 115200;
} // namespace Config

enum FiringState {
  IDLE,
  ARMING,
  SPINNING_UP,
  PUSHING,
  BRAKING,
  COOLDOWN,
  ESC_TEST
};
enum TiltState { TILT_IDLE, TILT_MOVING };

class Launcher {
private:
  // Original Variablennamen behalten
  Servo esc1, esc2, shotServo, tiltServo;

  FiringState firingState = IDLE;
  TiltState tiltState = TILT_IDLE;

  bool isArmed = false;
  uint32_t stateStartTime = 0;
  uint32_t tiltEndTime = 0;
  uint32_t lastActivityTime = 0;

  // Kalibrierwerte (Bezeichnungen wie im Original)
  int shotNeutralUs = Config::SHOT_NEUTRAL_DEFAULT;
  int tiltNeutralUs = Config::TILT_NEUTRAL_DEFAULT;
  int shotDurationMs = Config::SHOT_DURATION_DEFAULT;

  // Hilfsfunktion für synchrones & invertierbares Steuern
  void writeSyncESCs(int pwr) {
    int p = constrain(pwr, 0, 100);
    int us1 = Config::INV_1 ? map(p, 0, 100, Config::ESC_MAX, Config::ESC_MIN)
                            : map(p, 0, 100, Config::ESC_MIN, Config::ESC_MAX);
    int us2 = Config::INV_2 ? map(p, 0, 100, Config::ESC_MAX, Config::ESC_MIN)
                            : map(p, 0, 100, Config::ESC_MIN, Config::ESC_MAX);
    esc1.writeMicroseconds(us1);
    esc2.writeMicroseconds(us2);
  }

public:
  void begin() {
    lastActivityTime = millis();
    printHelp();
  }

  // Hilfs-Outputs
  void debugPrint(const __FlashStringHelper *msg) {
    Serial.println(msg);
    Serial1.println(msg);
  }
  void debugPrintf(const char *format, int value) {
    char buf[64];
    sprintf(buf, format, value);
    Serial.println(buf);
    Serial1.println(buf);
  }

  bool getArmed() { return isArmed; }

  // --- ARMING (Non-Blocking) ---
  void arm() {
    if (isArmed || firingState == ARMING)
      return;
    esc1.attach(Config::PIN_ESC_1, Config::ESC_MIN, Config::ESC_MAX);
    esc2.attach(Config::PIN_ESC_2, Config::ESC_MIN, Config::ESC_MAX);
    esc1.writeMicroseconds(Config::ESC_ARM);
    esc2.writeMicroseconds(Config::ESC_ARM);

    firingState = ARMING;
    stateStartTime = millis();
    lastActivityTime = millis();
    debugPrint(F("STATUS: ARMING sequence started..."));
  }

  void disarm() {
    isArmed = false;
    firingState = IDLE;
    if (esc1.attached())
      esc1.writeMicroseconds(Config::ESC_ARM);
    if (esc2.attached())
      esc2.writeMicroseconds(Config::ESC_ARM);
    shotServo.detach();
    tiltServo.detach();
    debugPrint(F("OK: SYSTEM STOPPED"));
  }

  // --- TEST FUNKTIONEN ---
  void testEsc(int pwr) {
    if (!isArmed) {
      debugPrint(F("ERR: Arm first!"));
      return;
    }
    writeSyncESCs(pwr);
    firingState = ESC_TEST;
    debugPrintf("OK: Flywheels Sync-Test at %d%%", pwr);
    lastActivityTime = millis();
  }

  void nudgeShot(bool forward) {
    shotServo.attach(Config::PIN_SHOT);
    int s = forward ? (shotNeutralUs + 300) : (shotNeutralUs - 300);
    shotServo.writeMicroseconds(s);
    delay(100);
    shotServo.writeMicroseconds(shotNeutralUs);
    delay(50);
    shotServo.detach();
    debugPrint(F("OK: Nudge executed"));
    lastActivityTime = millis();
  }

  // --- STATE MACHINE UPDATE ---
  void update() {
    uint32_t now = millis();

    if (isArmed && firingState == IDLE &&
        (now - lastActivityTime > Config::AUTO_DISARM_MS)) {
      disarm();
    }

    switch (firingState) {
    case IDLE:
      break;
    case ESC_TEST:
      break;

    case ARMING:
      if (now - stateStartTime >= Config::ARM_DELAY_MS) {
        isArmed = true;
        firingState = IDLE;
        debugPrint(F("OK: SYSTEM ARMED"));
      }
      break;

    case SPINNING_UP:
      if (now - stateStartTime >= Config::SPINUP_MS) {
        shotServo.attach(Config::PIN_SHOT);
        shotServo.writeMicroseconds(shotNeutralUs + Config::SHOT_SPEED_OFFSET);
        firingState = PUSHING;
        stateStartTime = now;
      }
      break;

    case PUSHING:
      if (now - stateStartTime >= (uint32_t)shotDurationMs) {
        shotServo.writeMicroseconds(shotNeutralUs - Config::BRAKE_OFFSET);
        firingState = BRAKING;
        stateStartTime = now;
      }
      break;

    case BRAKING:
      if (now - stateStartTime >= Config::BRAKE_MS) {
        shotServo.writeMicroseconds(shotNeutralUs);
        writeSyncESCs(0);
        firingState = COOLDOWN;
        stateStartTime = now;
      }
      break;

    case COOLDOWN:
      if (now - stateStartTime >= 100) {
        shotServo.detach();
        firingState = IDLE;
        debugPrint(F("OK: SHOT COMPLETE"));
      }
      break;
    }

    if (tiltState == TILT_MOVING && now >= tiltEndTime) {
      tiltServo.writeMicroseconds(tiltNeutralUs);
      delay(50);
      tiltServo.detach();
      tiltState = TILT_IDLE;
      debugPrint(F("OK: TILT STOPPED"));
    }
  }

  void startFire(int pwr) {
    if (!isArmed) {
      debugPrint(F("ERR: Arm first!"));
      return;
    }
    if (firingState != IDLE)
      return;
    writeSyncESCs(pwr);
    firingState = SPINNING_UP;
    stateStartTime = millis();
    lastActivityTime = millis();
  }

  void startTilt(bool up, uint32_t ms) {
    tiltServo.attach(Config::PIN_TILT);
    tiltServo.writeMicroseconds(up ? 2500 : 500);
    tiltEndTime = millis() + ms;
    tiltState = TILT_MOVING;
    lastActivityTime = millis();
  }

  // --- CONFIG & HELP ---
  void printConfig() {
    debugPrint(F("\n--- CURRENT CONFIG ---"));
    debugPrintf("Shot Zero:     %d us", shotNeutralUs);
    debugPrintf("Tilt Zero:     %d us", tiltNeutralUs);
    debugPrintf("Shot Duration: %d ms", shotDurationMs);
    debugPrint(F("----------------------"));
  }

  void printHelp() {
    debugPrint(F("\n--- COMMAND LIST ---"));
    debugPrint(F(" > ARM / DISARM      - Safety Control"));
    debugPrint(F(" > SHOT <pwr>        - Fire Sequence"));
    debugPrint(F(" > TEST_ESC <pwr>    - Test Flywheels"));
    debugPrint(F(" > NF / NB           - Nudge Shot"));
    debugPrint(F(" > UP / DN <ms>      - Tilt Move"));
    debugPrint(F(" > ZERO_S / ZERO_T   - Neutral points"));
    debugPrint(F(" > SET_SHOT <ms>     - Duration"));
    debugPrint(F(" > SAVE              - Show Config"));
    debugPrint(F("--------------------"));
  }

  void setZS(int v) {
    shotNeutralUs = v;
    debugPrintf("OK: Shot Zero set to %d", v);
  }
  void setZT(int v) {
    tiltNeutralUs = v;
    debugPrintf("OK: Tilt Zero set to %d", v);
  }
  void setD(int v) {
    shotDurationMs = v;
    debugPrintf("OK: Duration set to %d", v);
  }
};

class Comms {
  Launcher &launcher; // Name wie im Main-Part
  String buffer;

public:
  Comms(Launcher &l) : launcher(l) { buffer.reserve(32); }
  void update() {
    while (Serial.available()) {
      char c = Serial.read();
      if (c == '\n' || c == '\r') {
        if (buffer.length() > 0)
          execute();
        buffer = "";
      } else
        buffer += c;
    }
  }
  void execute() {
    buffer.trim();
    buffer.toUpperCase();
    int spaceIdx = buffer.indexOf(' ');
    String cmd = (spaceIdx == -1) ? buffer : buffer.substring(0, spaceIdx);
    int v = (spaceIdx == -1) ? 0 : buffer.substring(spaceIdx + 1).toInt();

    if (cmd == "ARM")
      launcher.arm();
    else if (cmd == "DISARM" || cmd == "STOP")
      launcher.disarm();
    else if (cmd == "SHOT")
      launcher.startFire(v > 0 ? v : 40);
    else if (cmd == "TEST_ESC")
      launcher.testEsc(v > 0 ? v : 20);
    else if (cmd == "NF")
      launcher.nudgeShot(true);
    else if (cmd == "NB")
      launcher.nudgeShot(false);
    else if (cmd == "UP")
      launcher.startTilt(true, v > 0 ? v : 200);
    else if (cmd == "DN")
      launcher.startTilt(false, v > 0 ? v : 200);
    else if (cmd == "ZERO_S")
      launcher.setZS(v);
    else if (cmd == "ZERO_T")
      launcher.setZT(v);
    else if (cmd == "SET_SHOT")
      launcher.setD(v);
    else if (cmd == "SAVE")
      launcher.printConfig();
    else if (cmd == "HELP")
      launcher.printHelp();
    else if (cmd == "STATUS")
      Serial.println(launcher.getArmed() ? F("STATUS: ARMED")
                                         : F("STATUS: DISARMED"));
  }
};

Launcher nerfLauncher;
Comms comms(nerfLauncher);

void setup() {
  Serial.begin(Config::BAUD_RATE);
  Serial1.begin(Config::BAUD_RATE);
  while (!Serial)
    ;
  nerfLauncher.begin();
}

void loop() {
  nerfLauncher.update();
  comms.update();
}