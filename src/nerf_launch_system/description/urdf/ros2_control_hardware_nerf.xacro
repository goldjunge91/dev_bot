<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="nerf_ros2_control_hardware" params="port">
        <ros2_control name="NerfSystem" type="system">
            <hardware>
                <plugin>nerf_launch_system/NerfSystem</plugin>
                <param name="port">$(arg port)</param>
                <param name="baud_rate">115200</param>
            </hardware>
            
            <joint name="trigger_joint">
                <command_interface name="position"/>
                <state_interface name="position"/>
            </joint>

            <joint name="dart_pusher_joint">
                <command_interface name="velocity"/>
                <state_interface name="velocity"/>
            </joint>

            <!-- Flywheel Joints entfernt: Firmware-FSM steuert Flywheels autonom via SHOT -->
            <!--
            <joint name="flywheel_left_joint">
                <command_interface name="velocity"/>
                <state_interface name="velocity"/>
            </joint>

            <joint name="flywheel_right_joint">
                <command_interface name="velocity"/>
                <state_interface name="velocity"/>
            </joint>
            -->

            <joint name="system_arming_joint">
                <command_interface name="position"/>
            </joint>

        </ros2_control>

    </xacro:macro>

</robot>
