{
  "configurations": [
    {
      "browse": {
        "databaseFilename": "${workspaceFolder}/.vscode/browse.vc.db",
        "limitSymbolsToIncludedHeaders": false
      },
      "name": "Linux",
      "includePath": [
        "/opt/ros/humble/include/**",
        "/usr/include/**",
        "${workspaceFolder}/**",
        "/opt/ros/humble/include/**"
      ],
      "compilerPath": "/usr/bin/gcc",
      "compileCommands": "${workspaceFolder}/src/nerf_standalone/compile_commands.json",
      "cStandard": "c99",
      "cppStandard": "c++17",
      "intelliSenseMode": "linux-gcc-x64"
    }
  ],
  "version": 4
}