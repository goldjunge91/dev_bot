{
  "configurations": [
    {
      "browse": {
        "databaseFilename": "${workspaceFolder}/.vscode/browse.vc.db",
        "limitSymbolsToIncludedHeaders": false
      },
      "name": "Linux",
      "includePath": [
        "${workspaceFolder}/**",
        "/opt/ros/${env:ROS_DISTRO}/include/**",
        "${workspaceFolder}/src/**/include",
        "${workspaceFolder}/src/mecanum_pico/hardware/include",
        "${workspaceFolder}/install/**/include",
        "/opt/ros/humble/include/**",
        "/usr/include/**"
      ],
      "defines": [],
      "compilerPath": "/usr/bin/gcc",
      "compileCommands": "${workspaceFolder}/build/compile_commands.json",
      "cStandard": "c99",
      "cppStandard": "c++17",
      "intelliSenseMode": "linux-gcc-x64"
    },
    {
      "name": "PlatformIO-Leonardo",
      "compilerPath": "/usr/bin/g++",
      "compileCommands": "${workspaceFolder}/src/nerf_launch_system/firmware/nerf_micro/compile_commands.json",
      "cStandard": "c11",
      "cppStandard": "c++17",
      "intelliSenseMode": "linux-gcc-x64"
    }
  ],
  "version": 4
}
